---
// src/components/Nav.astro — Header : logo | nav services | CTA tel
import SITE from '../config';
import { METAUX_NON_FERREUX, SERVICES_COMPLEMENTAIRES } from '../data/services';
---

<header class="hd">
  <div class="container hd__inner">

    <!-- Logo : icone (pictogramme recyclage CM) + texte reel (le logo complet contient
         du texte en 3 lignes illisible une fois reduit a la taille du header) -->
    <a href="/" class="logo">
      <img src={SITE.logoIcone} alt="" width="46" height="46" fetchpriority="high" decoding="async">
      <span class="logo__text">
        <strong>La Centrale des Métaux</strong>
        <small>Ferrailleur 93</small>
      </span>
    </a>

    <!-- Nav -->
    <nav class="nav" id="nav">
      <ul class="nav__list">
        <li><a href="/">Accueil</a></li>

        <li class="nav__dd">
          <a href="/achat-de-metaux-ferreux/">
            Achat de Metaux Ferreux
          </a>
        </li>

        <li class="nav__dd">
          <a href="/#metaux-non-ferreux">
            Achat de metaux non ferreux
            <svg width="10" height="6" viewBox="0 0 10 6"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
          </a>
          <ul class="nav__sub">
            {METAUX_NON_FERREUX.map((s) => (
              <li><a href={s.href}>{s.label}</a></li>
            ))}
          </ul>
        </li>

        <li class="nav__dd">
          <a href="/#services">
            Services
            <svg width="10" height="6" viewBox="0 0 10 6"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
          </a>
          <ul class="nav__sub">
            {SERVICES_COMPLEMENTAIRES.map((s) => (
              <li><a href={s.href}>{s.label}</a></li>
            ))}
          </ul>
        </li>

      </ul>

      <!-- Footer menu mobile -->
      <div class="nav__mobile-footer">
        <a href="/" class="nav__mobile-logo">
          <img src={SITE.logoTexte} alt={SITE.nom} height="110" loading="lazy" decoding="async">
        </a>
        <a href={SITE.telHref} class="nav__mobile-cta">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="7" y="2" width="10" height="20" rx="2.4" stroke="#fff" stroke-width="1.8"/><line x1="10.5" y1="18.4" x2="13.5" y2="18.4" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/></svg>
          {SITE.tel}
        </a>
        <div class="nav__mobile-nav">
          <a href={SITE.mapsUrl} class="btn btn--maps" target="_blank" rel="noopener">
            <img src="/assets/img/migration/icones-tiers/logo-google-maps.png" alt="" width="22" height="22" loading="lazy" decoding="async">
            Maps
          </a>
          <a href={SITE.wazeUrl} class="btn btn--waze" target="_blank" rel="noopener">
            <img src="/assets/img/migration/icones-tiers/waze-logo.png" alt="" width="22" height="22" loading="lazy" decoding="async">
            Waze
          </a>
        </div>
      </div>
    </nav>

    <!-- CTA desktop -->
    <div class="hd__cta">
      <a href={SITE.telHref} class="btn btn--accent">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="7" y="2" width="10" height="20" rx="2.4" stroke="#fff" stroke-width="1.8"/><line x1="10.5" y1="18.4" x2="13.5" y2="18.4" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/></svg>
        {SITE.tel}
      </a>
    </div>

    <!-- Burger mobile -->
    <button class="burger" id="burger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

  </div>
</header>
